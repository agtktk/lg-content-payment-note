---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {publishedArticles} from '../../lib/content';
import {site} from '../../data/site';
const articles=await publishedArticles();
---
<Base title={"회선과 스토어"} description={site.keyword+' '+"LG U+ 회선에서 콘텐츠 결제와 일반 휴대폰 결제를 구분하고 현재 설정을 확인하는 안내입니다."} crumbs={[{name:"회선과 스토어",url:"/topics/basics/"}]}><div class="page-intro"><p class="eyebrow">READING INDEX</p><h1>회선과 스토어</h1><p>{site.intro}</p></div><section><h2>이 주제에서 확인할 가이드</h2><div class="articles-grid">{articles.map(article=><ArticleCard article={article}/>)}</div><p><a href="/guide/">확인 질문을 정리하는 순서</a> · <a href="/topics/basics/">주제의 범위</a> · <a href="/about/">편집 원칙</a></p></section></Base>